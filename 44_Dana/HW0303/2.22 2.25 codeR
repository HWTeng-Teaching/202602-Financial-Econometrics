load(url("https://www.principlesofeconometrics.com/poe5/data/rdata/cex5_small.rdata"))
#a
hist(cex5_small$foodaway)
summary(cex5_small$foodaway)

#b
advanced <- cex5_small[cex5_small$advanced == 1, ]
summary(advanced$foodaway)
college <- cex5_small[cex5_small$college == 1, ]
summary(college$foodaway)
none <- cex5_small[cex5_small$advanced == 0 & cex5_small$college == 0, ]
summary(none$foodaway)

#c
cex5_log <- cex5_small[cex5_small$foodaway > 0, ]
hist(log(cex5_log$foodaway))
summary(log(cex5_log$foodaway))

#d
mod_log <- lm( log(foodaway) ~ income, data = cex5_log) 
summary(mod_log)

#e
plot(log(foodaway) ~ income, data = cex5_log)
abline(mod_log,col="blue")

#f
resid =  resid(mod_log)
plot(cex5_log$income, resid)
