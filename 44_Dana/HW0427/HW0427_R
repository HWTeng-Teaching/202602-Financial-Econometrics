install.packages("AER")
library(AER)

#a
load("C:/Users/USER/Desktop/NYCU/SEM2_Spring2026/Econometrics/mroz.rda")
married <-subset(mroz, lfp==1)

married$mothercoll <- ifelse(married$mothereduc>12,1,0)
married$fathercoll <- ifelse(married$fathereduc>12,1,0)

mean(married$mothercoll)
mean(married$fathercoll)


#b
cor(married[c("educ","mothercoll","fathercoll")])

#c
mom_iv <- ivreg(log(wage)~educ + exper + I(exper^2)|
                  exper + I(exper^2)+ mothercoll, data=married)
summary(mom_iv)

confint(mom_iv,"educ", level=0.95)


#d
first_stage_d <- lm(educ~exper + I(exper^2)+ mothercoll, data=married)
summary(first_stage_d)

#H0: mothercoll=0
linearHypothesis(first_stage_d,c("mothercoll=0"))

#e
momdad_iv <- ivreg(log(wage)~educ + exper + I(exper^2)|
                  exper + I(exper^2)+ mothercoll + fathercoll, data=married)
summary(momdad_iv)
confint(momdad_iv,"educ", level=0.95)

#f
first_stage_f <- lm(educ~exper + I(exper^2)+ mothercoll + fathercoll, data=married)
summary(first_stage_f)

#H0: mothercoll=fathercoll=0
linearHypothesis(first_stage_f,c("mothercoll=0", "fathercoll=0"))


