model_d_read <- lm(readscore ~ aide, data = subset(star5_small, regular == 1 | aide == 1))
summary(model_d_read)
model_d_math <- lm(mathscore ~ aide, data = subset(star5_small, regular == 1 | aide == 1))
summary(model_d_math)
load(url("https://www.principlesofeconometrics.com/poe5/data/rdata/star5_small.rdata"))
# 可以用 ls() 指令確認載入的資料框名稱，這邊假設名稱就是 star5_small
# --- (a) 比較小班 (small) 與常規班的綜合分數 ---
# subset 條件：過濾出常規班 (regular == 1) 或小班 (small == 1)
model_a <- lm(totalscore ~ small, data = subset(star5_small, regular == 1 | small == 1))
summary(model_a)
# --- (b) 閱讀 (readscore) 與數學 (mathscore) 的小班效應 ---
model_b_read <- lm(readscore ~ small, data = subset(star5_small, regular == 1 | small == 1))
summary(model_b_read)
model_b_math <- lm(mathscore ~ small, data = subset(star5_small, regular == 1 | small == 1))
summary(model_b_math)
# --- (c) 比較助教班 (aide) 與常規班的綜合分數 ---
# subset 條件：過濾出常規班 (regular == 1) 或助教班 (aide == 1)
model_c <- lm(totalscore ~ aide, data = subset(star5_small, regular == 1 | aide == 1))
summary(model_c)
# --- (d) 閱讀與數學的助教效應 ---
model_d_read <- lm(readscore ~ aide, data = subset(star5_small, regular == 1 | aide == 1))
summary(model_d_read)
model_d_math <- lm(mathscore ~ aide, data = subset(star5_small, regular == 1 | aide == 1))
# 載入資料庫
load(url("https://www.principlesofeconometrics.com/poe5/data/rdata/cex5_small.rdata"))
# --- a. FOODAWAY 的直方圖與摘要統計 ---
hist(cex5_small$foodaway, main="Histogram of FOODAWAY", xlab="FOODAWAY", col="lightblue")
summary(cex5_small$foodaway)
quantile(cex5_small$foodaway, probs = c(0.25, 0.75), na.rm = TRUE)
# --- b. 不同學歷家庭的 FOODAWAY 統計 ---
# subset 條件：advanced (高等學位), college (大學學位)
print("--- Advanced Degree ---")
summary(subset(cex5_small, advanced == 1)$foodaway)
print("--- College Degree ---")
summary(subset(cex5_small, college == 1)$foodaway)
print("--- No Advanced or College Degree ---")
summary(subset(cex5_small, advanced == 0 & college == 0)$foodaway)
# --- c. ln(FOODAWAY) 的直方圖與摘要統計 ---
# 在 R 語言中，log() 預設就是取自然對數 ln
hist(log(cex5_small$foodaway), main="Histogram of ln(FOODAWAY)", xlab="ln(FOODAWAY)", col="lightgreen")
summary(log(cex5_small$foodaway))
# --- 修正 d. 估計對數-線性迴歸模型 ---
# 改用 valid_data 來跑迴歸，避開 -Inf 的錯誤
model_d <- lm(log(foodaway) ~ income, data = valid_data)
summary(model_d)
# --- e. 繪製散佈圖與擬合線 ---
plot(valid_data$income, log(valid_data$foodaway),
     main="ln(FOODAWAY) vs INCOME", xlab="INCOME (in $100s)", ylab="ln(FOODAWAY)", pch=20, col="darkgray")
abline(model_d, col="red", lwd=2)
# --- f. 繪製殘差圖 ---
plot(valid_data$income, resid(model_d),
     main="Residuals vs INCOME", xlab="INCOME", ylab="Residuals", pch=20, col="purple")
