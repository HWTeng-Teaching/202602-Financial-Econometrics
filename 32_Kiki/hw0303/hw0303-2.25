q()
install.packages("devtools")
library(devtools)
install_git("https://github.com/ccolonescu/PoEdata")
library(PoEdata)   # 
load(url("https://www.principlesofeconometrics.com/poe5/data/rdata/star5_small.rdata"))
# --- (a) 
