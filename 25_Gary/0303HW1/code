# (a) & (b)

head(cex5_small)
summary(cex5_small$foodaway)

hist(cex5_small$foodaway, 
     main = "How much people spend on food away", 
     xlab = "Dollars per person", 
     col = "gray")

# (c)

data_adv <- subset(cex5_small, advanced == 1)
summary(data_adv$foodaway)
nrow(data_adv)

data_coll <- subset(cex5_small, college == 1)
summary(data_coll$foodaway)
nrow(data_coll)

data_none <- subset(cex5_small, college == 0 & advanced == 0)
summary(data_none$foodaway)
nrow(data_none)

# (d)

cex5_small$log_food <- log(cex5_small$foodaway)

my_model <- lm(log_food ~ income, data = cex5_small)
summary(my_model)

# (e)

plot(cex5_small$income, cex5_small$log_food, 
     main = "Income vs Log Food Spending",
     xlab = "Income", 
     ylab = "Log(Foodaway)")
abline(my_model, col = "blue")

# (f): Residual Analysis

my_resids <- residuals(my_model)

plot(cex5_small$income[!is.na(cex5_small$log_food)], 
     my_resids, 
     main = "Check Residuals",
     xlab = "Income", 
     ylab = "Errors")

abline(h = 0, lty = 2)
